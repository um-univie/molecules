# Simple aromatics
C1=CC=CC=C1, c1ccccc1           # Benzene
C1=CC=CN=C1, c1cccnc1           # Pyridine
C1=CC=NC=C1, c1ccncc1           # Pyridine
O1C=CC=C1, o1cccc1              # Furan
S1C=CC=C1, s1cccc1              # Thiophene
N1C=CC=C1, n1cccc1              # Pyrrole

# Fused systems
C1=CC=C2C=CC=CC2=C1, c1ccc2ccccc2c1     # Naphthalene
C1=CC=C2N=CC=CC2=C1, c1ccc2ncccc2c1     # Quinoline
C1=CC=C2C=CN=CC2=C1, c1ccc2ccncc2c1     # Isoquinoline
O1C=CC2=C1C=CC=C2, o1ccc2c1cccc2        # Benzofuran

# Multiple rings
C1=CC=C(C2=CC=CC=C2)C=C1, c1ccc(c2ccccc2)cc1    # Biphenyl
C1=CC=C(C=C1)C2=CC=CC=C2, c1ccc(cc1)c2ccccc2     # Biphenyl (alt)
C1=CC=CC2=CC3=CC=CC=C3C=C12, c1cccc2cc3ccccc3cc12  # Phenanthrene

# Substituted aromatics
CC1=CC=CC=C1, Cc1ccccc1         # Toluene
OC1=CC=CC=C1, Oc1ccccc1         # Phenol
NC1=CC=CC=C1, Nc1ccccc1         # Aniline
FC1=CC=CC=C1, Fc1ccccc1         # Fluorobenzene

# Heterocyclic systems
C1=CN=CN=C1, c1cncnc1           # Pyrimidine
C1=CN=CC=N1, c1cnccn1           # Pyrazine
N1=CN=CN=C1, n1cncnc1           # 1,3,5-Triazine
C1=CN=NC=C1, c1cnncc1           # Pyridazine

# Complex fused systems
C1=CC=C2C(=C1)C=CC3=CC=CC=C23, c1ccc2c(c1)ccc3ccccc23  # Phenanthrene
C1=CC=C2C3=CC=CC=C3C=CC2=C1, c1ccc2c3ccccc3ccc2c1      # Phenanthrene (alt)

# Heteroatom-rich systems
C1=CN=CC=N1, c1cnccn1           # Pyrazine
N1=CC=CC=N1, n1ccccn1            # Pyrazine
O1C=CN=C1, o1ccnc1              # Oxazole
S1C=CN=C1, s1ccnc1              # Thiazole

# Systems with exocyclic double bonds
C=C1C=CC=CC1=O, C=C1C=CC=CC1=O  # Not aromatic
C1=CC=C(C=C)C=C1, c1ccc(C=C)cc1 # Styrene

# Multiple fused rings with heteroatoms
C1=CC2=NC=CC=C2C=C1, c1cc2ncccc2cc1     # Quinoline
C1=CC2=CC=NC=C2C=C1, c1cc2ccncc2cc1     # Isoquinoline
C1=CC2=NC=CN=C2C=C1, c1cc2nccnc2cc1     # Quinazoline

# Complex heterocyclic systems
C1=CC2=C(C=C1)N=CN=C2, c1cc2c(cc1)ncnc2   # Quinazoline
C1=CC=C2C(=C1)N=CN=C2, c1ccc2c(c1)ncnc2   # Quinazoline (alt)
C1=CC2=C(C=C1)N=CC=N2, c1cc2c(cc1)nccn2   # Quinoxaline
